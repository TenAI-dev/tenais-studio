# =============================================================================
# Node.js & General Dependencies
# =============================================================================
# Dependency directories
node_modules/
jspm_packages/

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*

# Diagnostic reports (https://nodejs.org/api/report.html)
report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json

# Runtime data
pids
*.pid
*.seed
*.pid.lock

# Directory for instrumented libs generated by jscoverage/JSCover
lib-cov

# Coverage directory used by tools like istanbul
coverage
*.lcov

# nyc test coverage
.nyc_output

# Grunt intermediate storage (https://gruntjs.com/creating-plugins#storing-temporary-files)
.grunt

# Bower dependency directory (https://bower.io/)
bower_components

# node-waf configuration
.lock-wscript

# Compiled binary addons (https://nodejs.org/api/addons.html)
build/Release

# =============================================================================
# Environment Variables
# =============================================================================
# Ignore all .env files to prevent leaking sensitive information.
# Use .env.example as a template for required variables.
.env
.env.*
!.env.example
!.env.ci

# =============================================================================
# Expo & React Native
# =============================================================================
# Expo-specific files
.expo/
dist/
web-build/
expo-env.d.ts

# Metro bundler cache
.metro-health-check*

# iOS build artifacts
#
# If you are using prebuild, you may want to commit the ios/ and android/ directories.
# If you are not, you should ignore them.
# ios/build/
# ios/Pods/

# Android build artifacts
#
# android/app/build/
# android/build/
# android/.gradle/

# Keystores and signing certificates
*.jks
*.p8
*.p12
*.key
*.mobileprovision
*.orig

# =============================================================================
# Operating System & IDE Files
# =============================================================================
# macOS
.DS_Store
.AppleDouble
.LSOverride

# Thumbnails
._*

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini

# IDE-specific files
# Visual Studio Code
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.code-workspace

# JetBrains (WebStorm, etc.)
.idea/

# =-===========================================================================
# TypeScript & Build Artifacts
# =============================================================================
# TypeScript build info
*.tsbuildinfo

# Compiled JavaScript files (if you are compiling TS to JS in the same directory)
# *.js
# *.js.map
# !*.config.js
# !*rc.js

# =============================================================================
# Other
# =============================================================================
# Temporary files
*.tmp
*.swp
*~
